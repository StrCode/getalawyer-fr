# API Configuration
NUXT_PUBLIC_API_URL=https://localhost:3000
NUXT_PUBLIC_BETTER_AUTH_URL=https://localhost:3000/api/auth

# Better Auth (Server-side)
BETTER_AUTH_SECRET=<random-256-bit-key>
